# two problems on different meshes (3D and 2D) written to the same file
DEBUT(LANG="EN")
m3d = LIRE_MAILLAGE(UNITE=20, FORMAT="MED")
m3d = MODI_MAILLAGE(reuse=m3d, MAILLAGE=m3d, ORIE_PEAU=_F(GROUP_MA_PEAU=("Inner",)))
m2d = LIRE_MAILLAGE(UNITE=21, FORMAT="MED")
steel = DEFI_MATERIAU(ELAS=_F(E=200000.0, NU=0.3))
mo3 = AFFE_MODELE(MAILLAGE=m3d, AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="3D"))
ma3 = AFFE_MATERIAU(MAILLAGE=m3d, AFFE=_F(GROUP_MA="Tube", MATER=steel))
ch3 = AFFE_CHAR_MECA(MODELE=mo3,
    DDL_IMPO=(_F(GROUP_MA="SymX", DX=0.0), _F(GROUP_MA="SymY", DY=0.0), _F(GROUP_MA="Bottom", DZ=0.0)),
    PRES_REP=_F(GROUP_MA="Inner", PRES=10.0))
r3d = MECA_STATIQUE(MODELE=mo3, CHAM_MATER=ma3, EXCIT=_F(CHARGE=ch3))
mo2 = AFFE_MODELE(MAILLAGE=m2d, AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="AXIS"))
ma2 = AFFE_MATERIAU(MAILLAGE=m2d, AFFE=_F(GROUP_MA="Body", MATER=steel))
ch2 = AFFE_CHAR_MECA(MODELE=mo2, DDL_IMPO=_F(GROUP_MA="Bottom", DY=0.0), PRES_REP=_F(GROUP_MA="Inner", PRES=20.0))
r2d = MECA_STATIQUE(MODELE=mo2, CHAM_MATER=ma2, EXCIT=_F(CHARGE=ch2))
IMPR_RESU(FORMAT="MED", UNITE=80, RESU=(_F(RESULTAT=r3d, NOM_CHAM=("DEPL", "SIEF_ELGA")),
                                        _F(RESULTAT=r2d, NOM_CHAM=("DEPL", "SIEF_ELGA"))))
FIN()
