# axisymmetric thick-walled tube under internal pressure, free end: Lamé solution
DEBUT(LANG="EN")
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT="MED")
model = AFFE_MODELE(MAILLAGE=mesh, AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="AXIS"))
steel = DEFI_MATERIAU(ELAS=_F(E=200000.0, NU=0.3))
mater = AFFE_MATERIAU(MAILLAGE=mesh, AFFE=_F(GROUP_MA="Body", MATER=steel))
load = AFFE_CHAR_MECA(MODELE=model, DDL_IMPO=_F(GROUP_MA="Bottom", DY=0.0), PRES_REP=_F(GROUP_MA="Inner", PRES=10.0))
ramp = DEFI_FONCTION(NOM_PARA="INST", VALE=(0.0, 0.0, 1.0, 1.0))
times = DEFI_LIST_REEL(DEBUT=0.0, INTERVALLE=_F(JUSQU_A=1.0, NOMBRE=2))
resu = MECA_STATIQUE(MODELE=model, CHAM_MATER=mater, EXCIT=_F(CHARGE=load, FONC_MULT=ramp), LIST_INST=times)
resu = CALC_CHAMP(reuse=resu, RESULTAT=resu, CONTRAINTE=("SIGM_ELNO", "SIGM_NOEU"), CRITERES=("SIEQ_ELGA",))
IMPR_RESU(FORMAT="MED", UNITE=80, RESU=_F(RESULTAT=resu,
          NOM_CHAM=("DEPL", "SIEF_ELGA", "SIEQ_ELGA", "SIGM_ELNO", "SIGM_NOEU")))
FIN()
