# plate with a hole in plane strain, pulled in x
DEBUT(LANG="EN")
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT="MED")
mesh = CREA_MAILLAGE(MAILLAGE=mesh, LINE_QUAD=_F(TOUT="OUI"))
model = AFFE_MODELE(MAILLAGE=mesh, AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="D_PLAN"))
steel = DEFI_MATERIAU(ELAS=_F(E=200000.0, NU=0.3))
mater = AFFE_MATERIAU(MAILLAGE=mesh, AFFE=_F(GROUP_MA="Body", MATER=steel))
load = AFFE_CHAR_MECA(MODELE=model, DDL_IMPO=(_F(GROUP_MA="SymX", DX=0.0), _F(GROUP_MA="SymY", DY=0.0)),
                      PRES_REP=_F(GROUP_MA="Right", PRES=-100.0))
resu = MECA_STATIQUE(MODELE=model, CHAM_MATER=mater, EXCIT=_F(CHARGE=load))
resu = CALC_CHAMP(reuse=resu, RESULTAT=resu, CONTRAINTE=("SIGM_ELNO", "SIGM_NOEU"), CRITERES=("SIEQ_ELGA",))
IMPR_RESU(FORMAT="MED", UNITE=80, RESU=_F(RESULTAT=resu,
          NOM_CHAM=("DEPL", "SIEF_ELGA", "SIEQ_ELGA", "SIGM_ELNO", "SIGM_NOEU")))
FIN()
