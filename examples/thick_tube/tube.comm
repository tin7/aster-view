# Thick-walled tube under internal pressure (Lame problem), quarter model, HEXA20.
# Units: mm, N, MPa. Pressure ramped from 0 to 10 MPa in 4 steps.
# With free ends (sigma_z = 0) the 3D linear-elastic solution is exactly Lame's:
#   sigma_r = A - B / r**2,  sigma_theta = A + B / r**2,  A = p a**2 / (b**2 - a**2),  B = A b**2
DEBUT(LANG="EN")

mesh = LIRE_MAILLAGE(UNITE=20, FORMAT="MED")
mesh = MODI_MAILLAGE(reuse=mesh, MAILLAGE=mesh, ORIE_PEAU=_F(GROUP_MA_PEAU=("Inner",)))

# TOUT="OUI": the pressure faces must belong to the model too (MODELISA6_96 otherwise)
model = AFFE_MODELE(MAILLAGE=mesh, AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="3D"))
steel = DEFI_MATERIAU(ELAS=_F(E=200000.0, NU=0.3))
mater = AFFE_MATERIAU(MAILLAGE=mesh, AFFE=_F(GROUP_MA="Tube", MATER=steel))

load = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=(_F(GROUP_MA="SymX", DX=0.0), _F(GROUP_MA="SymY", DY=0.0), _F(GROUP_MA="Bottom", DZ=0.0)),
    PRES_REP=_F(GROUP_MA="Inner", PRES=10.0),
)
ramp = DEFI_FONCTION(NOM_PARA="INST", VALE=(0.0, 0.0, 1.0, 1.0))
times = DEFI_LIST_REEL(DEBUT=0.0, INTERVALLE=_F(JUSQU_A=1.0, NOMBRE=4))

resu = MECA_STATIQUE(MODELE=model, CHAM_MATER=mater, EXCIT=_F(CHARGE=load, FONC_MULT=ramp),
                     LIST_INST=times, INST_FIN=1.0)
resu = CALC_CHAMP(reuse=resu, RESULTAT=resu, CONTRAINTE=("SIGM_NOEU",))

IMPR_RESU(FORMAT="MED", UNITE=80, RESU=_F(RESULTAT=resu, NOM_CHAM=("DEPL", "SIEF_ELGA", "SIGM_NOEU")))
FIN()
